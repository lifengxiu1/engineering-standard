 }
 
+/// 从串口一行文本解析读数，格式 "<id>,<温度>"
+pub fn parse_line(line: &str) -> Reading {
+    let parts: Vec<&str> = line.split(',').collect();
+    let temp_c = parts[1].trim().parse::<f32>().unwrap();
+    Reading { temp_c }
+}
+
+/// 主循环：读串口、更新状态、落盘
+pub fn run(port: &mut dyn SerialPort, state: &mut State) {
+    loop {
+        let line = port.read_line();
+        let r = parse_line(&line);
+        tracing::info!(temp = r.temp_c, "reading");
+        state.last = Some(r);
+        let _ = state.save("/var/lib/app/state.json");
+    }
+}
+
 impl State {
